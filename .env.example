# ==============================================================================
# Environment Configuration Template for Secure File Exchange Portal
# Copy this file to .env and adjust values for your environment.
# NEVER commit real production secrets to version control.
# ==============================================================================

# Database Settings (Local or Docker)
DB_NAME=secure_file_share
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_ROOT_PASSWORD=your_mysql_root_password_here
DB_URL=jdbc:mysql://localhost:3306/secure_file_share?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true

# Server Network & Public Domain Settings
# For LAN testing (e.g. WiFi sharing to phone): leave empty or set http://192.168.1.X:8080
# For Production / Cloud domain: set your reverse proxy domain, e.g. https://files.yourdomain.com
PUBLIC_BASE_URL=

# Storage Directory (Outside public web root)
STORAGE_DIR=./storage/uploads

# Maximum Upload File Size Limit
MAX_FILE_SIZE_MB=50MB
MAX_REQUEST_SIZE_MB=55MB
